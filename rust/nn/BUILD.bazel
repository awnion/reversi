load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The network is evaluated once per MCTS simulation in the browser; SIMD128 is
# supported by every current browser and lets the inner loops vectorise.
WASM_SIMD = select({
    "@platforms//cpu:wasm32": ["-Ctarget-feature=+simd128"],
    "//conditions:default": [],
})

rust_library(
    name = "nn",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "reversi_nn",
    rustc_flags = WASM_SIMD,
    visibility = ["//visibility:public"],
)

# Same crate with `AlphaZeroNet::zeros()` enabled, for tests only.
rust_library(
    name = "nn_test_utils",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["test-utils"],
    crate_name = "reversi_nn",
    visibility = ["//rust:__subpackages__"],
)

rust_test(
    name = "nn_test",
    srcs = ["tests/nn_test.rs"],
    compile_data = [
        "//weights:alphazero/champion.bin",
        "//weights:zerorev/champion.bin",
    ],
    deps = [":nn_test_utils"],
)
