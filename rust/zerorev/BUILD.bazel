load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")

# cdylib for wasm32 with the champion weights embedded; see :wasm.
rust_shared_library(
    name = "zerorev_cdylib",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//weights:zerorev/champion.bin"],
    crate_name = "reversi_zerorev",
    rustc_env_files = ["//tools:build_env"],
    deps = [
        "//rust/mcts",
        "//rust/minimax",
        "//rust/nn",
        "@crates//:js-sys",
        "@crates//:wasm-bindgen",
    ],
)

# JS glue + .wasm for the browser, in bazel-bin/rust/zerorev/wasm/.
# `bun run build:wasm` copies it to packages/bot-zerorev/wasm/.
rust_wasm_bindgen(
    name = "wasm",
    out_name = "reversi_zerorev",
    target = "web",
    wasm_file = ":zerorev_cdylib",
)
