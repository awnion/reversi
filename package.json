{
  "name": "reversi",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:wasm && bun --filter @reversi/web dev",
    "build": "bun run build:wasm && bun --filter @reversi/web build",
    "build:wasm": "tools/build_wasm.sh",
    "test": "bun run test:unit",
    "test:all": "bun run test:unit && bun run test:e2e",
    "test:unit": "bun run build:wasm && bun test",
    "test:e2e": "bun run build && bunx playwright test",
    "test:e2e:headed": "bunx playwright test --headed",
    "install:browsers": "bunx playwright install chromium webkit",
    "lint": "bunx biome check && bunx tsc -b --pretty",
    "lint:fix": "bunx biome check --write",
    "format": "uvx ruff format . && cargo fmt --all && bunx biome check --write && uvx taplo fmt",
    "precommit": "uvx pre-commit run --all-files",
    "check": "bun run lint && bun run test:unit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.65.0",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
