# Training checkpoints (too many/large to track)
iter_*.npz

# Replay buffer (large, regenerated from self-play)
replay_buffer.npz
*.tmp.npz

# PID files and logs
train.pid
nohup.pid
train.log

# Keep champion.bin tracked (deployed to WASM bot)
!champion.bin

# Transient training state
selfplay_latest.bin
replay_spool/
replay_buffer.tmp
*.bad

# Cool-down marker written by the trainer
cooldown

# Local mirror of the training run on the remote machine, written by
# `just snapshot`; the champions worth keeping go to <bot>/champions/.
zerorev-v2/
