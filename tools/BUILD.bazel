# Env file consumed by the bot crates via `rustc_env_files`: embeds the build
# date from tools/workspace_status.sh.
genrule(
    name = "build_env",
    outs = ["build.env"],
    cmd = """
date=$$(sed -n 's/^STABLE_BUILD_DATE //p' bazel-out/stable-status.txt)
echo "BUILD_DATE=$${date:-dev}" > $@
""",
    stamp = 1,
    visibility = ["//rust:__subpackages__"],
)
